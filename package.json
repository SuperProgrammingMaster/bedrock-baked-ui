{
  "name": "bedrock-baked-ui",
  "version": "0.3.1",
  "description": "HTML/CSS/Canvas to Minecraft Bedrock JsonUI + Entity Inventory UI compiler & runtime SDK",
  "license": "MIT",
  "author": "SuperProgrammingMaster",
  "homepage": "https://github.com/SuperProgrammingMaster/bedrock-baked-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SuperProgrammingMaster/bedrock-baked-ui.git"
  },
  "bugs": {
    "url": "https://github.com/SuperProgrammingMaster/bedrock-baked-ui/issues"
  },
  "type": "module",
  "bin": {
    "bedrock-baked-ui": "dist/cli.js",
    "baked-ui": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./runtime/sim": {
      "types": "./dist/runtime/sim.d.ts",
      "import": "./dist/runtime/sim.js"
    },
    "./runtime/menu": {
      "types": "./dist/runtime/menu.d.ts",
      "import": "./dist/runtime/menu.js"
    },
    "./runtime/hud": {
      "types": "./dist/runtime/hud.d.ts",
      "import": "./dist/runtime/hud.js"
    },
    "./runtime/hud-sim": {
      "types": "./dist/runtime/hud_sim.d.ts",
      "import": "./dist/runtime/hud_sim.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "minecraft",
    "bedrock",
    "jsonui",
    "ui",
    "script-api",
    "addon",
    "html-to-jsonui"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "peerDependencies": {
    "@minecraft/server": "*",
    "@minecraft/server-ui": "*"
  },
  "peerDependenciesMeta": {
    "@minecraft/server": {
      "optional": true
    },
    "@minecraft/server-ui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@minecraft/server": "2.12.0-beta.1.26.63-stable",
    "@minecraft/server-ui": "2.4.0-beta.1.26.63-stable",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  }
}
